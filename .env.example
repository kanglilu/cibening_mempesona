# Salin file ini ke .env.local untuk pengembangan lokal, dan set nilai yang sama
# di Environment Variables hosting (Vercel) untuk production.

# ASPIRASI_WEBHOOK_URL: URL Google Apps Script Web App (deployment /exec)
# yang menerima kiriman Formulir Pelayanan lalu menulisnya ke Google Sheets.
# Wajib diisi, kalau kosong endpoint /api/aspirasi akan menolak semua kiriman.
ASPIRASI_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Supabase: sumber data halaman /loker.
# Ambil di Supabase > Project Settings > API.
# Kalau kosong, halaman loker tetap tampil tapi isinya kosong (tidak error).
#
# Tanpa prefix NEXT_PUBLIC_ karena semua query dijalankan di server component,
# jadi key tidak ikut terkirim ke browser dan nilainya dibaca saat runtime
# (mengubahnya di Vercel tidak mengharuskan rebuild).
#
# Yang menjaga data tetap aman adalah Row Level Security di supabase/schema.sql:
# publik hanya boleh membaca baris berstatus 'terbit'.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
